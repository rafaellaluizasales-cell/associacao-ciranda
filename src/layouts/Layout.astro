---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import institucional from '../data/institucional.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Associação Cultural CIRANDA — Teatro, Arte & Cultura em Barra do Garças / MT",
  description = "Site oficial da Associação Cultural Ciranda. Conheça nossos projetos teatrais, agenda cultural, peças em cartaz e inscreva-se nas oficinas gratuitas em Barra do Garças / MT.",
  image = "/images/logo-ciranda.jpg"
} = Astro.props;

const pageTitle = title.includes("CIRANDA") ? title : `${title} | Associação Cultural CIRANDA`;
const canonicalURL = new URL(Astro.url.pathname, institucional.urlOficial);
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpg" href="/images/logo-ciranda.jpg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="Associação Cultural Ciranda" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, institucional.urlOficial)} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, institucional.urlOficial)} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  </head>
  <body class="bg-ciranda-cream text-ciranda-dark flex flex-col min-h-screen antialiased">
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />

    <!-- Global Fullscreen Image Expand Modal with Interactive Zoom -->
    <div 
      id="global-image-modal" 
      class="fixed inset-0 z-[100] hidden bg-black/95 backdrop-blur-md flex flex-col items-center justify-between p-2 sm:p-4 select-none"
      onclick="window.closeImageModal()"
    >
      <!-- Top Control Bar -->
      <div 
        class="w-full max-w-6xl flex items-center justify-between gap-3 px-3 py-2.5 bg-stone-900/90 text-white rounded-2xl border border-stone-800 shadow-2xl z-20 shrink-0"
        onclick="event.stopPropagation()"
      >
        <div class="flex items-center gap-2 truncate pr-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-ciranda-amber shrink-0"></span>
          <h4 id="global-modal-caption" class="text-xs sm:text-sm font-serif font-bold text-stone-200 truncate">Visualização da Imagem</h4>
        </div>

        <!-- Zoom & Action Controls -->
        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
          <button 
            id="modal-zoom-out" 
            type="button" 
            class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-stone-800 hover:bg-stone-700 text-white font-bold flex items-center justify-center text-base sm:text-lg transition shadow-sm"
            title="Reduzir Zoom (-)"
            aria-label="Reduzir Zoom"
          >
            −
          </button>
          
          <button 
            id="modal-zoom-reset" 
            type="button" 
            class="px-2.5 sm:px-3 h-8 sm:h-9 rounded-lg bg-stone-800 hover:bg-stone-700 text-stone-200 font-mono text-xs font-semibold flex items-center justify-center transition shadow-sm"
            title="Ajustar à Tela (100%)"
            aria-label="Redefinir Zoom"
          >
            <span id="modal-zoom-level">100%</span>
          </button>

          <button 
            id="modal-zoom-in" 
            type="button" 
            class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-stone-800 hover:bg-stone-700 text-white font-bold flex items-center justify-center text-base sm:text-lg transition shadow-sm"
            title="Aumentar Zoom (+)"
            aria-label="Aumentar Zoom"
          >
            +
          </button>

          <div class="w-px h-5 bg-stone-700 mx-1"></div>

          <button 
            onclick="window.closeImageModal()" 
            class="w-8 h-8 sm:w-9 sm:h-9 bg-red-600/80 hover:bg-red-600 text-white rounded-lg flex items-center justify-center text-sm font-bold transition shadow-sm"
            aria-label="Fechar Modal"
            title="Fechar (Esc)"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Main Image Viewport Area -->
      <div 
        id="modal-image-viewport" 
        class="relative flex-grow w-full max-w-6xl my-2 overflow-auto rounded-2xl bg-stone-950/95 border border-stone-800/80 p-3 sm:p-6 select-none flex"
        onclick="event.stopPropagation()"
      >
        <img 
          id="global-modal-img" 
          src="" 
          alt="Imagem Ampliada" 
          class="m-auto transition-all duration-200 ease-out select-none max-h-[78vh] max-w-full object-contain cursor-zoom-in rounded-lg shadow-2xl"
          draggable="false"
        />
      </div>

      <!-- Bottom Hint Bar -->
      <div class="text-xs text-stone-300 py-1 flex items-center justify-center gap-2 text-center" onclick="event.stopPropagation()">
        <span>💡 <strong>Dica no computador:</strong> clique na imagem ou use <strong>+</strong> / <strong>−</strong> para aproximar, e role a roda do mouse para ler o cartaz de cima a baixo.</span>
      </div>
    </div>

    <script is:inline>
      let currentZoom = 1.0;
      const MIN_ZOOM = 1.0;
      const MAX_ZOOM = 2.4;
      const ZOOM_STEP = 0.25;

      function updateZoom(newZoom) {
        currentZoom = Math.min(Math.max(newZoom, MIN_ZOOM), MAX_ZOOM);
        const img = document.getElementById('global-modal-img');
        const levelLabel = document.getElementById('modal-zoom-level');
        const viewport = document.getElementById('modal-image-viewport');
        
        if (img) {
          if (currentZoom <= 1.02) {
            currentZoom = 1.0;
            img.style.height = 'auto';
            img.style.maxHeight = '78vh';
            img.style.maxWidth = '100%';
            img.style.width = 'auto';
            img.classList.remove('cursor-zoom-out');
            img.classList.add('cursor-zoom-in');
          } else {
            // Desktop proportional zoom: scale relative to screen height
            const isPortrait = (img.naturalHeight || 1) >= (img.naturalWidth || 1);
            const baseH = Math.min(window.innerHeight * 0.78, 720);
            
            if (isPortrait) {
              const targetH = Math.round(baseH * currentZoom);
              img.style.height = targetH + 'px';
              img.style.maxHeight = 'none';
              img.style.maxWidth = 'none';
              img.style.width = 'auto';
            } else {
              const baseW = Math.min((viewport ? viewport.clientWidth : 800) * 0.9, 900);
              const targetW = Math.round(baseW * currentZoom);
              img.style.width = targetW + 'px';
              img.style.maxWidth = 'none';
              img.style.maxHeight = 'none';
              img.style.height = 'auto';
            }
            img.classList.remove('cursor-zoom-in');
            img.classList.add('cursor-zoom-out');
          }
        }
        if (levelLabel) {
          levelLabel.textContent = `${Math.round(currentZoom * 100)}%`;
        }
      }

      window.openImageModal = function(src, caption) {
        const modal = document.getElementById('global-image-modal');
        const img = document.getElementById('global-modal-img');
        const cap = document.getElementById('global-modal-caption');
        if (modal && img) {
          img.src = src;
          if (cap) cap.textContent = caption || 'Visualização da Imagem';
          currentZoom = 1.0;
          updateZoom(1.0);
          modal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          
          const viewport = document.getElementById('modal-image-viewport');
          if (viewport) {
            viewport.scrollLeft = 0;
            viewport.scrollTop = 0;
          }
        }
      };

      window.closeImageModal = function() {
        const modal = document.getElementById('global-image-modal');
        if (modal) {
          modal.classList.add('hidden');
          document.body.style.overflow = '';
          currentZoom = 1.0;
          updateZoom(1.0);
        }
      };

      // Close on Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') window.closeImageModal();
      });

      function setupZoomControls() {
        const btnIn = document.getElementById('modal-zoom-in');
        const btnOut = document.getElementById('modal-zoom-out');
        const btnReset = document.getElementById('modal-zoom-reset');
        const viewport = document.getElementById('modal-image-viewport');
        const img = document.getElementById('global-modal-img');

        if (btnIn && !btnIn.dataset.bound) {
          btnIn.dataset.bound = 'true';
          btnIn.addEventListener('click', (e) => {
            e.stopPropagation();
            updateZoom(currentZoom + ZOOM_STEP);
          });
        }

        if (btnOut && !btnOut.dataset.bound) {
          btnOut.dataset.bound = 'true';
          btnOut.addEventListener('click', (e) => {
            e.stopPropagation();
            updateZoom(currentZoom - ZOOM_STEP);
          });
        }

        if (btnReset && !btnReset.dataset.bound) {
          btnReset.dataset.bound = 'true';
          btnReset.addEventListener('click', (e) => {
            e.stopPropagation();
            updateZoom(1.0);
            if (viewport) {
              viewport.scrollTop = 0;
              viewport.scrollLeft = 0;
            }
          });
        }

        // Click on image toggles between 100% and 145% (comfortable reading size)
        if (img && !img.dataset.bound) {
          img.dataset.bound = 'true';
          img.addEventListener('click', (e) => {
            e.stopPropagation();
            if (currentZoom > 1.05) {
              updateZoom(1.0);
              if (viewport) {
                viewport.scrollTop = 0;
              }
            } else {
              updateZoom(1.45);
            }
          });
        }

        // Mouse wheel: Ctrl+Wheel zooms; normal Wheel scrolls vertically naturally!
        if (viewport && !viewport.dataset.bound) {
          viewport.dataset.bound = 'true';
          viewport.addEventListener('wheel', (e) => {
            if (e.ctrlKey) {
              e.preventDefault();
              const delta = e.deltaY < 0 ? ZOOM_STEP : -ZOOM_STEP;
              updateZoom(currentZoom + delta);
            }
            // Normal wheel: default browser behavior scrolls the viewport up and down!
          }, { passive: false });

          // Drag to Pan when zoomed
          let isDragging = false;
          let startX = 0;
          let startY = 0;
          let scrollLeft = 0;
          let scrollTop = 0;

          viewport.addEventListener('mousedown', (e) => {
            if (currentZoom <= 1.05) return;
            if (e.button !== 0) return;
            isDragging = true;
            viewport.classList.add('cursor-grabbing');
            startX = e.pageX - viewport.offsetLeft;
            startY = e.pageY - viewport.offsetTop;
            scrollLeft = viewport.scrollLeft;
            scrollTop = viewport.scrollTop;
          });

          window.addEventListener('mouseup', () => {
            if (isDragging) {
              isDragging = false;
              viewport.classList.remove('cursor-grabbing');
            }
          });

          viewport.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            e.preventDefault();
            const x = e.pageX - viewport.offsetLeft;
            const y = e.pageY - viewport.offsetTop;
            const walkX = (x - startX);
            const walkY = (y - startY);
            viewport.scrollLeft = scrollLeft - walkX;
            viewport.scrollTop = scrollTop - walkY;
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupZoomControls);
      } else {
        setupZoomControls();
      }
      document.addEventListener('astro:page-load', setupZoomControls);
    </script>
  </body>
</html>
