---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import institucional from '../data/institucional.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Associação Cultural CIRANDA — Teatro, Arte & Cultura em Barra do Garças / MT",
  description = "Site oficial da Associação Cultural Ciranda. Conheça nossos projetos teatrais, agenda cultural, peças em cartaz e inscreva-se nas oficinas gratuitas em Barra do Garças / MT.",
  image = "/images/logo-ciranda.jpg"
} = Astro.props;

const pageTitle = title.includes("CIRANDA") ? title : `${title} | Associação Cultural CIRANDA`;
const canonicalURL = new URL(Astro.url.pathname, institucional.urlOficial);
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpg" href="/images/logo-ciranda.jpg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="Associação Cultural Ciranda" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, institucional.urlOficial)} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, institucional.urlOficial)} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  </head>
  <body class="bg-ciranda-cream text-ciranda-dark flex flex-col min-h-screen antialiased">
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
