---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import institucional from '../data/institucional.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Associação Cultural CIRANDA — Teatro, Arte & Cultura em Barra do Garças / MT",
  description = "Site oficial da Associação Cultural Ciranda. Conheça nossos projetos teatrais, agenda cultural, peças em cartaz e inscreva-se nas oficinas gratuitas em Barra do Garças / MT.",
  image = "/images/logo-ciranda.jpg"
} = Astro.props;

const pageTitle = title.includes("CIRANDA") ? title : `${title} | Associação Cultural CIRANDA`;
const canonicalURL = new URL(Astro.url.pathname, institucional.urlOficial);
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpg" href="/images/logo-ciranda.jpg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="Associação Cultural Ciranda" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, institucional.urlOficial)} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, institucional.urlOficial)} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  </head>
  <body class="bg-ciranda-cream text-ciranda-dark flex flex-col min-h-screen antialiased">
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />

    <!-- Global Fullscreen Image Expand Modal -->
    <div 
      id="global-image-modal" 
      class="fixed inset-0 z-[100] hidden bg-black/90 backdrop-blur-md flex items-center justify-center p-4 transition-all duration-300"
      onclick="window.closeImageModal()"
    >
      <div class="relative max-w-5xl w-full bg-stone-950 rounded-3xl overflow-hidden border border-stone-800 shadow-2xl" onclick="event.stopPropagation()">
        <button 
          onclick="window.closeImageModal()" 
          class="absolute top-4 right-4 z-20 w-11 h-11 bg-black/70 text-white rounded-full flex items-center justify-center text-xl font-bold hover:bg-ciranda-terracotta transition shadow-lg"
          aria-label="Fechar"
        >
          ✕
        </button>
        <div class="bg-black flex items-center justify-center max-h-[80vh] overflow-hidden p-2">
          <img id="global-modal-img" src="" alt="Imagem Ampliada" class="w-auto h-auto max-h-[78vh] max-w-full object-contain rounded-xl" />
        </div>
        <div class="p-5 bg-stone-900 text-white">
          <h4 id="global-modal-caption" class="text-lg font-serif font-bold text-stone-100"></h4>
        </div>
      </div>
    </div>

    <script is:inline>
      window.openImageModal = function(src, caption) {
        const modal = document.getElementById('global-image-modal');
        const img = document.getElementById('global-modal-img');
        const cap = document.getElementById('global-modal-caption');
        if (modal && img) {
          img.src = src;
          if (cap) cap.textContent = caption || '';
          modal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }
      };

      window.closeImageModal = function() {
        const modal = document.getElementById('global-image-modal');
        if (modal) {
          modal.classList.add('hidden');
          document.body.style.overflow = '';
        }
      };

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') window.closeImageModal();
      });
    </script>
  </body>
</html>
