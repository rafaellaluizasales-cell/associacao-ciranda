---
import Layout from '../../layouts/Layout.astro';
import noticias from '../../data/noticias.json';

export function getStaticPaths() {
  return noticias.map((noticia) => ({
    params: { slug: noticia.slug },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;
---

<Layout 
  title={`${noticia.titulo} | Notícias | Associação Cultural CIRANDA`} 
  description={noticia.subtitulo || noticia.resumo}
  image={noticia.imagem}
>
  <!-- Breadcrumb & Top Bar -->
  <section class="bg-ciranda-cream pt-10 pb-6 border-b border-ciranda-border/60">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-between gap-3 text-xs sm:text-sm">
        <a 
          href="/noticias" 
          class="inline-flex items-center gap-1.5 font-bold uppercase tracking-wider text-ciranda-terracotta hover:text-ciranda-terracotta-dark transition"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Voltar para Notícias
        </a>

        <div class="flex items-center gap-2 text-stone-500 text-xs">
          <span class="badge-tag text-[11px]">{noticia.categoria}</span>
          <span>•</span>
          <time datetime={noticia.dataIso}>{noticia.data}</time>
        </div>
      </div>
    </div>
  </section>

  <!-- Article Main Content -->
  <article class="py-12 sm:py-16 bg-white min-h-[70vh]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <!-- Article Header -->
      <header class="space-y-4">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-black text-ciranda-brown leading-tight tracking-tight">
          {noticia.titulo}
        </h1>

        {noticia.subtitulo && (
          <p class="text-stone-600 text-lg sm:text-xl leading-relaxed border-l-4 border-ciranda-amber pl-4 py-1">
            {noticia.subtitulo}
          </p>
        )}

        <!-- Meta Author & Source -->
        <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-stone-100 text-xs text-stone-500">
          <div class="flex items-center gap-2">
            <span class="font-bold text-stone-800">Publicado originalmente por:</span>
            <span class="px-2.5 py-0.5 rounded-full bg-stone-100 text-stone-700 font-semibold border border-stone-200">
              {noticia.fonte}
            </span>
          </div>

          <a 
            href={noticia.fonteUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-ciranda-terracotta hover:underline font-bold inline-flex items-center gap-1"
          >
            Ver matéria original no portal oficial ↗
          </a>
        </div>
      </header>

      <!-- Featured Real Image -->
      <figure class="space-y-3">
        <div 
          class="relative rounded-2xl overflow-hidden border border-ciranda-border shadow-elevated bg-stone-900 cursor-pointer group"
          title="Clique para ampliar a foto"
          onclick={`if(window.openImageModal){ window.openImageModal('${noticia.imagem}', '${noticia.titulo}'); }`}
        >
          <img 
            src={noticia.imagem} 
            alt={noticia.titulo} 
            class="w-full h-auto max-h-[550px] object-cover group-hover:scale-[1.02] transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <span class="bg-stone-950/85 text-white text-xs px-3.5 py-2 rounded-full font-bold shadow-lg flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
              </svg>
              Clique para ampliar a imagem
            </span>
          </div>
        </div>

        {noticia.legendaImagem && (
          <figcaption class="text-xs text-stone-500 italic text-center">
            Foto: {noticia.legendaImagem}
          </figcaption>
        )}
      </figure>

      <!-- Article Body Paragraphs -->
      <div class="space-y-5 text-stone-800 text-base sm:text-lg leading-relaxed text-justify pt-2">
        {noticia.paragrafos.map((p: string) => (
          <p class="leading-relaxed">
            {p}
          </p>
        ))}
      </div>

      <!-- Institutional Source & Verification Box -->
      <div class="mt-12 p-6 sm:p-8 rounded-3xl bg-ciranda-cream border-2 border-ciranda-border shadow-soft space-y-4">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-2xl bg-ciranda-amber/20 text-ciranda-brown flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-ciranda-terracotta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
          </div>
          <div class="space-y-1">
            <h3 class="text-lg font-bold font-serif text-ciranda-brown">
              Publicação Oficial no Portal Governamental
            </h3>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              Esta matéria foi publicada pelos canais de comunicação da <strong>Prefeitura Municipal de Rondonópolis - MT</strong>, ressaltando o Termo de Colaboração com a <strong>Associação Cultural Ciranda</strong> para o Ciclo II da Política Nacional Aldir Blanc (PNAB).
            </p>
          </div>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-end gap-3">
          <a 
            href={noticia.fonteUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-primary text-xs sm:text-sm uppercase tracking-wider inline-flex items-center justify-center gap-2"
          >
            Acessar Notícia no Portal da Prefeitura ↗
          </a>
        </div>
      </div>

      <!-- Bottom Navigation Back Button -->
      <div class="pt-8 border-t border-stone-200 flex items-center justify-between">
        <a 
          href="/noticias" 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold uppercase tracking-wider text-ciranda-terracotta bg-ciranda-terracotta/10 hover:bg-ciranda-terracotta hover:text-white transition-all duration-200"
        >
          ← Voltar para a lista de Notícias
        </a>

        <a 
          href="/contato" 
          class="text-xs text-stone-500 hover:text-ciranda-terracotta font-semibold"
        >
          Assessoria de Imprensa & Contato →
        </a>
      </div>

    </div>
  </article>
</Layout>
