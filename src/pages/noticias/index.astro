---
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import noticias from '../../data/noticias.json';
---

<Layout 
  title="Notícias & Imprensa | Associação Cultural CIRANDA" 
  description="Acompanhe as notícias, matérias na mídia, editais e novidades institucionais da Associação Cultural Ciranda."
>
  <!-- Hero Section -->
  <section class="bg-ciranda-brown text-white py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-ciranda-amber text-ciranda-brown mb-3">
        Ciranda na Mídia
      </span>
      <h1 class="text-4xl sm:text-5xl font-serif font-bold text-white mb-4">
        Notícias
      </h1>
      <p class="text-stone-300 text-base sm:text-lg max-w-2xl mx-auto">
        Acompanhe a repercussão das nossas ações culturais, parcerias públicas, matérias de imprensa e avanços na comunidade.
      </p>
    </div>
  </section>

  <!-- News Listing Section -->
  <section class="py-16 sm:py-24 bg-ciranda-cream min-h-[60vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {noticias.map((item) => (
          <NewsCard noticia={item} />
        ))}
      </div>

    </div>
  </section>
</Layout>
