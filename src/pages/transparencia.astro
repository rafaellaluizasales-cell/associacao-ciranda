---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Transparência | Associação Cultural CIRANDA" 
  description="Portal de Transparência da Associação Cultural Ciranda. Documentos, relatórios, parcerias e prestação de contas institucionais."
>
  <section class="bg-ciranda-brown text-white py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-ciranda-amber text-ciranda-brown mb-3">
        Gestão & Compromisso Social
      </span>
      <h1 class="text-4xl sm:text-5xl font-serif font-bold text-white mb-4">
        Portal da Transparência
      </h1>
      <p class="text-stone-300 text-base sm:text-lg max-w-2xl mx-auto">
        Acesso a documentos institucionais, relatórios de atividades, parcerias públicas e prestação de contas da Associação Cultural Ciranda.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-24 bg-ciranda-cream">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-white p-8 sm:p-12 rounded-3xl border border-ciranda-border shadow-soft text-center space-y-6">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-ciranda-amber/20 text-ciranda-brown flex items-center justify-center">
          <svg class="w-8 h-8 text-ciranda-terracotta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>

        <div class="space-y-2">
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-ciranda-brown">
            Em Atualização
          </h2>
          <p class="text-stone-600 text-sm sm:text-base max-w-md mx-auto leading-relaxed">
            Esta seção está sendo estruturada para disponibilizar os relatórios, atas, termos de fomento e certidões da entidade. Em breve todos os documentos estarão disponíveis para consulta pública.
          </p>
        </div>

        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/sobre" class="btn-primary text-xs uppercase tracking-wider">
            Ver Certificações em Quem Somos
          </a>
          <a href="/contato" class="btn-secondary text-xs uppercase tracking-wider">
            Solicitar Informações
          </a>
        </div>
      </div>

    </div>
  </section>
</Layout>
