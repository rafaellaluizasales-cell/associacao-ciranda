---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import projetos from '../../data/projetos.json';
const projetosApenas = projetos.filter(p => p.slug === 'cultura-em-movimento');
---

<Layout 
  title="Projetos Culturais | Associação Cultural CIRANDA" 
  description="Conheça os projetos socioculturais, ações formativas e iniciativas comunitárias desenvolvidas pela Associação Cultural Ciranda."
>
  <section class="bg-ciranda-brown text-white py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-ciranda-amber text-ciranda-brown mb-3">
        Ações Socioculturais
      </span>
      <h1 class="text-4xl sm:text-5xl font-serif font-bold text-white mb-4">
        Projetos
      </h1>
      <p class="text-stone-300 text-base sm:text-lg max-w-2xl mx-auto">
        Projetos continuados de formação artística, descentralização cultural e inclusão social na comunidade.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-24 bg-ciranda-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projetosApenas.map((proj) => (
          <ProjectCard projeto={proj} />
        ))}
      </div>

    </div>
  </section>
</Layout>
