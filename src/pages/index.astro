---
import Layout from '../layouts/Layout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EventCard from '../components/EventCard.astro';
import institucional from '../data/institucional.json';
import projetos from '../data/projetos.json';
import agenda from '../data/agenda.json';
import oficinas from '../data/oficinas.json';
import depoimentos from '../data/depoimentos.json';

const projetosDestaque = projetos.filter(p => p.destaqueHome).slice(0, 3);
const proximosEventos = agenda.filter(a => a.destaqueHome).slice(0, 3);
---

<Layout title="Início | Associação Cultural CIRANDA">
  
  <!-- Hero Section -->
  <HeroBanner />

  <!-- Seção Quem Somos / Chamada Institucional -->
  <section class="py-16 sm:py-24 bg-ciranda-cream">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-8 text-center max-w-4xl mx-auto">
        
        <div class="space-y-4">
          <span class="badge-tag">História & Propósito</span>
          <h2 class="text-3xl sm:text-4xl font-serif font-bold text-ciranda-brown leading-tight">
            Promovendo arte, cultura viva e desenvolvimento humano no Araguaia.
          </h2>
        </div>

        <p class="text-stone-700 text-base sm:text-lg leading-relaxed text-justify sm:text-center">
          A <strong class="text-ciranda-brown">Associação Cultural CIRANDA</strong> atua para a promoção do desenvolvimento social, artístico e cultural na região do Araguaia, especialmente nos aspectos que dizem respeito à sua relação com os processos educativos e de desenvolvimento do Ser Humano. Seus objetivos são divulgar e fomentar ações culturais para a construção da identidade regional e dar suporte na organização de ações que visem o desenvolvimento humano de forma integral, por meio de articulações com outras instituições.
        </p>

        <!-- Selos & Certificações Rápidas -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-left">
          <div class="p-5 bg-white rounded-2xl border border-ciranda-border shadow-soft space-y-2">
            <span class="block text-xs font-bold uppercase tracking-wider text-ciranda-terracotta">Ponto de Cultura</span>
            <p class="text-xs text-stone-600 leading-relaxed">
              Certificada pelo <strong>Estado de Mato Grosso</strong> e <strong>Governo Federal</strong>, integrando a Política Nacional de Cultura Viva.
            </p>
          </div>

          <div class="p-5 bg-white rounded-2xl border border-ciranda-border shadow-soft space-y-2">
            <span class="block text-xs font-bold uppercase tracking-wider text-ciranda-brown">Utilidade Pública</span>
            <p class="text-xs text-stone-600 leading-relaxed">
              Reconhecida pelo <strong>CMDCA de Barra do Garças</strong> e com título de <strong>Utilidade Pública Municipal (2024)</strong>.
            </p>
          </div>

          <div class="p-5 bg-white rounded-2xl border border-ciranda-border shadow-soft space-y-2">
            <span class="block text-xs font-bold uppercase tracking-wider text-amber-700">Conselho de Cultura</span>
            <p class="text-xs text-stone-600 leading-relaxed">
              Membro ativa do <strong>Conselho Municipal de Cultura</strong> de Barra do Garças - MT desde sua fundação em 2018.
            </p>
          </div>
        </div>

        <div class="pt-2">
          <a href="/sobre" class="btn-secondary text-sm shadow-sm inline-flex items-center gap-2">
            Conhecer a História Completa da Ciranda →
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Destaques de Projetos & Peças Teatrais -->
  <section class="py-16 sm:py-24 bg-white border-t border-ciranda-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
        <div>
          <span class="badge-tag mb-2">Repertório & Montagens</span>
          <h2 class="text-3xl sm:text-4xl font-serif font-bold text-ciranda-brown">
            Projetos Teatrais em Destaque
          </h2>
        </div>
        <a href="/projetos" class="inline-flex items-center gap-2 text-sm font-bold text-ciranda-terracotta hover:underline">
          Ver Todos os Projetos
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projetosDestaque.map((proj) => (
          <ProjectCard projeto={proj} />
        ))}
      </div>

    </div>
  </section>

  <!-- Agenda Resumida da Ciranda -->
  <section class="py-16 sm:py-24 bg-ciranda-cream border-t border-ciranda-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="badge-tag mb-2">Programação</span>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-ciranda-brown">
          Próximos Eventos & Espetáculos
        </h2>
        <p class="text-stone-600 text-sm mt-2">
          Acompanhe as datas das próximas apresentações e encontros da Ciranda em Barra do Garças.
        </p>
      </div>

      <div class="space-y-6 max-w-4xl mx-auto">
        {proximosEventos.map((evt) => (
          <EventCard evento={evt} />
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/agenda" class="btn-primary text-sm shadow">
          Ver Calendário Completo da Agenda
        </a>
      </div>

    </div>
  </section>

  <!-- Chamada para Oficinas -->
  <section class="py-16 sm:py-20 bg-ciranda-brown text-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center lg:text-left">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 space-y-4">
          <span class="inline-block px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-ciranda-amber text-ciranda-brown">
            Inscrições Abertas
          </span>
          <h2 class="text-3xl sm:text-4xl font-serif font-bold text-white leading-tight">
            Quer fazer teatro com a Ciranda?
          </h2>
          <p class="text-stone-300 text-base max-w-2xl">
            Oferecemos oficinas de teatro, jogos cênicos e contação de histórias para iniciantes. Participe e desenvolva sua expressão artística!
          </p>
        </div>
        <div class="lg:col-span-4 flex justify-center lg:justify-end">
          <a href="/oficinas" class="btn-primary bg-ciranda-amber text-ciranda-brown hover:bg-white py-4 px-8 text-base">
            Inscreva-se Agora
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Depoimentos Rápidos -->
  <section class="py-16 sm:py-24 bg-white border-t border-ciranda-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="badge-tag mb-2">Vozes da Comunidade</span>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-ciranda-brown">
          O que dizem sobre a Ciranda
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {depoimentos.map((dep) => (
          <div class="bg-ciranda-card p-6 rounded-2xl border border-ciranda-border shadow-soft flex flex-col justify-between">
            <p class="text-sm text-stone-700 italic leading-relaxed mb-6">
              "{dep.texto}"
            </p>
            <div class="flex items-center gap-3 pt-4 border-t border-ciranda-border">
              <img src={dep.avatar} alt={dep.autor} class="w-10 h-10 rounded-full object-cover" />
              <div>
                <h4 class="text-sm font-bold text-ciranda-brown">{dep.autor}</h4>
                <p class="text-xs text-stone-500">{dep.funcao}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
      
      <div class="text-center mt-10">
        <a href="/depoimentos" class="text-sm font-bold text-ciranda-terracotta hover:underline">
          Deixar ou ver mais depoimentos →
        </a>
      </div>
    </div>
  </section>

</Layout>
