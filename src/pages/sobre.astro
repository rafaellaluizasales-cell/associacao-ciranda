---
import Layout from '../layouts/Layout.astro';
import institucional from '../data/institucional.json';
---

<Layout 
  title="A Ciranda | Associação Cultural Ciranda" 
  description="Conheça a história, missão, atuação artística e valores da Associação Cultural Ciranda em Barra do Garças / MT."
>
  <!-- Page Header -->
  <section class="bg-ciranda-brown text-white py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-ciranda-amber text-ciranda-brown mb-3">
        Quem Somos
      </span>
      <h1 class="text-4xl sm:text-5xl font-serif font-bold text-white mb-4">
        A Associação Cultural CIRANDA
      </h1>
      <p class="text-stone-300 text-base sm:text-lg max-w-2xl mx-auto">
        História, compromisso social e paixão pela arte cênica em Barra do Garças / MT.
      </p>
    </div>
  </section>

  <!-- History & Mission Section -->
  <section class="py-16 sm:py-24 bg-ciranda-cream">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="bg-white p-8 sm:p-12 rounded-3xl border border-ciranda-border shadow-soft space-y-6">
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-ciranda-brown">
          Nossa História
        </h2>
        <p class="text-stone-700 leading-relaxed">
          A <strong class="text-ciranda-brown">CIRANDA (Associação Cultural Ciranda)</strong> nasceu do desejo de integrar artistas, educadores e a comunidade através das artes cênicas, música e manifestações culturais populares em Barra do Garças e na região do Araguaia.
        </p>
        <p class="text-stone-700 leading-relaxed">
          [CONTEÚDO Ciranda: Espaço reservado para a cliente Juliane ("Ju") inserir o texto completo sobre a fundação, os primeiros espetáculos e a trajetória histórica da associação].
        </p>
      </div>

      <!-- Values Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-ciranda-border shadow-soft space-y-3">
          <div class="w-12 h-12 rounded-xl bg-ciranda-amber/20 text-ciranda-brown font-serif font-bold text-2xl flex items-center justify-center">
            M
          </div>
          <h3 class="font-serif font-bold text-xl text-ciranda-brown">Missão</h3>
          <p class="text-sm text-stone-600">
            Promover e democratizar a produção artística teatral, oferecendo formação gratuita e de qualidade para crianças, jovens e adultos.
          </p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-ciranda-border shadow-soft space-y-3">
          <div class="w-12 h-12 rounded-xl bg-ciranda-terracotta/20 text-ciranda-terracotta font-serif font-bold text-2xl flex items-center justify-center">
            V
          </div>
          <h3 class="font-serif font-bold text-xl text-ciranda-brown">Visão</h3>
          <p class="text-sm text-stone-600">
            Ser um polo cultural de referência regional no Estado de Mato Grosso, fortalecendo a cena teatral e a literatura oral.
          </p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-ciranda-border shadow-soft space-y-3">
          <div class="w-12 h-12 rounded-xl bg-ciranda-olive/20 text-ciranda-olive font-serif font-bold text-2xl flex items-center justify-center">
            Val
          </div>
          <h3 class="font-serif font-bold text-xl text-ciranda-brown">Valores</h3>
          <p class="text-sm text-stone-600">
            Acolhimento, diversidade, responsabilidade social, valorização da memória popular e incentivo à criação coletiva.
          </p>
        </div>
      </div>

      <!-- Institutional Sheet Box -->
      <div class="bg-ciranda-card p-8 rounded-3xl border border-ciranda-border shadow-soft space-y-4">
        <h3 class="text-xl font-serif font-bold text-ciranda-brown border-b border-ciranda-border pb-3">
          Dados Institucionais da Associação
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-stone-700">
          <div>
            <span class="block text-xs uppercase font-bold text-stone-500">Nome Oficial / Razão Social</span>
            <span class="font-semibold text-ciranda-brown">{institucional.razaoSocial}</span>
          </div>
          <div>
            <span class="block text-xs uppercase font-bold text-stone-500">CNPJ</span>
            <span class="font-semibold text-ciranda-brown">{institucional.cnpj}</span>
          </div>
          <div>
            <span class="block text-xs uppercase font-bold text-stone-500">Natureza Jurídica</span>
            <span>{institucional.naturezaJuridica}</span>
          </div>
          <div>
            <span class="block text-xs uppercase font-bold text-stone-500">Responsável Geral</span>
            <span>{institucional.responsavel}</span>
          </div>
          <div class="sm:col-span-2">
            <span class="block text-xs uppercase font-bold text-stone-500">Endereço da Sede</span>
            <span>{institucional.endereco.completo}</span>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>
