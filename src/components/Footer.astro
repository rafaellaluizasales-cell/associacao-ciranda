---
import institucional from '../data/institucional.json';

const currentYear = new Date().getFullYear();
---

<footer class="bg-ciranda-dark text-stone-300 pt-16 pb-8 border-t border-stone-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-stone-800">
      
      <!-- Col 1: Institutional Brand Info -->
      <div class="space-y-4 lg:col-span-1">
        <div class="flex items-center gap-3">
          <img 
            src="/images/logo-ciranda.jpg" 
            alt="Logo Associação Cultural Ciranda" 
            class="h-14 w-auto rounded-lg bg-white p-1"
          />
          <div>
            <span class="block text-[10px] font-bold uppercase tracking-widest text-ciranda-amber">Associação Cultural</span>
            <span class="block text-xl font-bold font-serif text-white leading-none">CIRANDA</span>
          </div>
        </div>
        <p class="text-sm text-stone-400 leading-relaxed">
          Promovendo a arte, o teatro, a cultura viva e a formação comunitária em Barra do Garças e região do Araguaia.
        </p>
        <div class="pt-1">
          <span class="inline-block px-3 py-1 text-xs font-medium rounded-md bg-stone-800 text-stone-300 border border-stone-700">
            CNPJ: {institucional.cnpj}
          </span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="space-y-3">
        <h3 class="text-base font-bold font-serif text-white tracking-wide uppercase text-xs text-ciranda-amber">
          Navegação
        </h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-ciranda-amber transition">Início</a></li>
          <li><a href="/sobre" class="hover:text-ciranda-amber transition">A Ciranda & História</a></li>
          <li><a href="/projetos" class="hover:text-ciranda-amber transition">Projetos & Peças Teatrais</a></li>
          <li><a href="/agenda" class="hover:text-ciranda-amber transition">Agenda Cultural</a></li>
          <li><a href="/oficinas" class="hover:text-ciranda-amber transition">Oficinas Teatrais</a></li>
          <li><a href="/galeria" class="hover:text-ciranda-amber transition">Galeria de Fotos</a></li>
          <li><a href="/depoimentos" class="hover:text-ciranda-amber transition">Depoimentos</a></li>
          <li><a href="/contato" class="hover:text-ciranda-amber transition">Contato & Localização</a></li>
        </ul>
      </div>

      <!-- Col 3: Contact & Address -->
      <div class="space-y-3 lg:col-span-2">
        <h3 class="text-base font-bold font-serif text-white tracking-wide uppercase text-xs text-ciranda-amber">
          Sede & Contato
        </h3>
        <div class="space-y-2.5 text-sm text-stone-300">
          <p class="flex items-start gap-2.5">
            <svg class="w-5 h-5 text-ciranda-terracotta shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{institucional.endereco.completo}</span>
          </p>

          <p class="flex items-center gap-2.5">
            <svg class="w-5 h-5 text-emerald-500 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <a href={institucional.contato.whatsappLink} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition font-medium">
              WhatsApp: {institucional.contato.whatsappDisplay}
            </a>
          </p>

          <p class="flex items-center gap-2.5">
            <svg class="w-5 h-5 text-ciranda-amber shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${institucional.contato.email}`} class="hover:text-white transition">
              {institucional.contato.email}
            </a>
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Developer Credit Bar -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500">
      
      <!-- Copyright -->
      <div>
        © {currentYear} Associação Cultural CIRANDA. Todos os direitos reservados.
      </div>

      <!-- Discrete Creator Credit (Rafaella Borges - Soluções Digitais) -->
      <div class="flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-stone-900/90 border border-stone-800 text-stone-400 hover:text-stone-200 transition">
        <img 
          src={institucional.desenvolvedor.avatar} 
          alt="Foto Rafaella Borges" 
          class="w-7 h-7 rounded-full object-cover object-[center_35%] border border-ciranda-amber/50 shadow-sm"
        />
        <span>
          Desenvolvido por <strong class="text-stone-300 font-semibold">{institucional.desenvolvedor.nome}</strong>
        </span>
      </div>

    </div>

  </div>
</footer>
