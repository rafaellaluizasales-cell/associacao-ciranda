---
interface Props {
  noticia: {
    id: string;
    slug: string;
    titulo: string;
    subtitulo?: string;
    data: string;
    categoria: string;
    fonte: string;
    fonteUrl: string;
    imagem: string;
    resumo: string;
  };
}

const { noticia } = Astro.props;
---

<article class="bg-ciranda-card rounded-2xl overflow-hidden border border-ciranda-border shadow-soft hover:shadow-elevated transition-all duration-300 flex flex-col group hover:-translate-y-1">
  
  <!-- Top Meta Bar -->
  <div class="px-5 pt-4 pb-3 flex items-center justify-between gap-2 border-b border-ciranda-border/60 bg-stone-50/80">
    <span class="badge-tag text-[11px]">
      {noticia.categoria}
    </span>
    <span class="text-[11px] font-semibold text-stone-500 flex items-center gap-1">
      <svg class="w-3.5 h-3.5 text-ciranda-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      {noticia.data}
    </span>
  </div>

  <!-- Image Area with Click to Expand -->
  <div 
    class="relative h-60 sm:h-64 overflow-hidden bg-stone-100 cursor-pointer group/img"
    title="Clique para ampliar a imagem"
    onclick={`if(window.openImageModal){ window.openImageModal('${noticia.imagem}', '${noticia.titulo}'); }`}
  >
    <img 
      src={noticia.imagem} 
      alt={noticia.titulo} 
      class="w-full h-full object-cover group-hover/img:scale-105 transition-transform duration-500"
    />
    <div class="absolute inset-0 bg-black/20 opacity-0 group-hover/img:opacity-100 transition-opacity flex items-center justify-center">
      <span class="bg-stone-900/90 text-white text-xs px-3 py-1.5 rounded-full font-bold shadow-md flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
        </svg>
        Clique para ampliar
      </span>
    </div>

    <!-- Source tag overlay -->
    <div class="absolute bottom-3 left-3">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-stone-950/80 backdrop-blur-sm text-stone-200 border border-stone-700/60 shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        Fonte: {noticia.fonte}
      </span>
    </div>
  </div>

  <!-- Content Section -->
  <div class="p-6 flex flex-col flex-grow">
    <h3 class="text-xl font-bold font-serif text-ciranda-brown group-hover:text-ciranda-terracotta transition-colors mb-3 leading-snug">
      <a href={`/noticias/${noticia.slug}`}>
        {noticia.titulo}
      </a>
    </h3>
    
    <p class="text-sm text-stone-600 leading-relaxed mb-6 flex-grow">
      {noticia.resumo}
    </p>

    <div class="pt-4 border-t border-ciranda-border flex items-center justify-between mt-auto">
      <a 
        href={noticia.fonteUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-1 text-[11px] font-semibold text-stone-500 hover:text-ciranda-terracotta transition"
        title="Ver matéria original"
      >
        <span>Portal Oficial ↗</span>
      </a>

      <a 
        href={`/noticias/${noticia.slug}`} 
        class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-ciranda-terracotta hover:text-ciranda-terracotta-dark group-hover:translate-x-1 transition-all"
      >
        Ler Notícia
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>

</article>
