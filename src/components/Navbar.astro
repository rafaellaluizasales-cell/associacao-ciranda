---
import institucional from '../data/institucional.json';

const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Home', path: '/' },
  { name: 'A Ciranda', path: '/sobre' },
  { name: 'Projetos & Peças', path: '/projetos' },
  { name: 'Agenda', path: '/agenda' },
  { name: 'Oficinas', path: '/oficinas' },
  { name: 'Galeria', path: '/galeria' },
  { name: 'Depoimentos', path: '/depoimentos' },
  { name: 'Contato', path: '/contato' },
];
---

<header class="sticky top-0 z-50 bg-ciranda-cream/95 backdrop-blur-md border-b border-ciranda-border transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 sm:h-24">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group py-2">
        <img 
          src="/images/logo-ciranda.jpg" 
          alt="Logo Associação Cultural Ciranda" 
          class="h-12 sm:h-16 w-auto object-contain rounded-lg shadow-sm transition-transform duration-300 group-hover:scale-105"
        />
        <div class="hidden sm:block">
          <span class="block text-xs font-semibold uppercase tracking-widest text-ciranda-terracotta">Associação Cultural</span>
          <span class="block text-xl font-bold font-serif text-ciranda-brown leading-tight">CIRANDA</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2">
        {navLinks.map((link) => {
          const isActive = currentPath === link.path || (link.path !== '/' && currentPath.startsWith(link.path));
          return (
            <a
              href={link.path}
              class={`px-3.5 py-2 rounded-full text-sm font-medium transition-all duration-200 ${
                isActive
                  ? 'bg-ciranda-terracotta text-white font-semibold shadow-sm'
                  : 'text-ciranda-dark hover:text-ciranda-terracotta hover:bg-ciranda-amber/10'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Mobile Menu Button -->
      <div class="flex items-center gap-3">
        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label="Abrir Menu de Navegação"
          class="lg:hidden p-2.5 rounded-xl text-ciranda-brown hover:bg-ciranda-amber/15 focus:outline-none"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="hidden w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden bg-ciranda-card border-b border-ciranda-border shadow-lg">
    <div class="px-4 pt-3 pb-6 space-y-2">
      {navLinks.map((link) => {
        const isActive = currentPath === link.path || (link.path !== '/' && currentPath.startsWith(link.path));
        return (
          <a
            href={link.path}
            class={`block px-4 py-3 rounded-xl text-base font-medium transition-all ${
              isActive
                ? 'bg-ciranda-terracotta text-white font-semibold'
                : 'text-ciranda-dark hover:bg-ciranda-amber/15 hover:text-ciranda-brown'
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggleBtn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>
